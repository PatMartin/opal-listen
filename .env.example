# OPAL dotenv example.
# Startup reads ./.env by default; real environment variables always win,
# including empty strings. Use --env-file PATH for another file, or
# --no-env-file to disable loading and initialization. Secret values stay
# local; this example is safe to commit.

# OPAL_LISTENER_HOST
#OPAL_LISTENER_HOST=0.0.0.0

# OPAL_LISTENER_PORT
#OPAL_LISTENER_PORT=8000

# OPAL_LISTENER_DATA_DIR
#OPAL_LISTENER_DATA_DIR=var

# OPAL_LISTENER_DATABASE_FILE
#OPAL_LISTENER_DATABASE_FILE=opal_listener.db

# OPAL_LISTENER_CONFIG_DIR
#OPAL_LISTENER_CONFIG_DIR=opal_listener/config

# OPAL_LISTENER_VOSK_MODEL_PATH
#OPAL_LISTENER_VOSK_MODEL_PATH=/resources/vosk/models/vosk-model-small-en-us-0.15

# OPAL_LISTENER_CORS_ORIGINS
#OPAL_LISTENER_CORS_ORIGINS=*

# OPAL_LISTENER_MAX_UPLOAD_BYTES
#OPAL_LISTENER_MAX_UPLOAD_BYTES=10485760

# OPAL_LISTENER_SEED_ON_EMPTY
#OPAL_LISTENER_SEED_ON_EMPTY=true

# OPAL_LISTENER_API_TOKEN
#OPAL_LISTENER_API_TOKEN=<optional-bearer-token>

# OPAL_LISTENER_XPUB_URL
#OPAL_LISTENER_XPUB_URL=tcp://127.0.0.1:5555

# OPAL_LISTENER_OPAL_EVENT_URL
#OPAL_LISTENER_OPAL_EVENT_URL=http://127.0.0.1:8080

# OPAL_LISTENER_OPAL_EVENT_TOKEN
#OPAL_LISTENER_OPAL_EVENT_TOKEN=<optional-opal-event-token>

# OPAL_LISTENER_EVENT_TRANSPORT
#OPAL_LISTENER_EVENT_TRANSPORT=http

